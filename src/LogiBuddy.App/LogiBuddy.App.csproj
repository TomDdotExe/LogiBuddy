<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LogiBuddy.Core\LogiBuddy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used directly by Audio/CalibrationAnnouncer.cs (also flows transitively via Core). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.3</Version>
    <!-- Ship a clean end-user exe name (LogiBuddy.exe, not
         LogiBuddy.App.exe). Nothing derives paths from the
         assembly name. -->
    <AssemblyName>LogiBuddy</AssemblyName>
    <!-- Source of truth lives in the root Images/ folder (design assets),
         not duplicated into the project. -->
    <ApplicationIcon>..\..\Images\logibuddy-light.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embeds the same icon as a WPF resource (Resources/AppIcon.ico) so
         Window.Icon can reference it via pack URI, without duplicating the
         file — Link keeps the physical file in the root Images/ folder. -->
    <Resource Include="..\..\Images\logibuddy-light.ico" Link="Resources\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Condition guards against MSB3030 (missing-file copy error) until phonon.dll
         is actually placed here (Task 8 Step 1, intentionally not done by this
         dispatch — see task-8-report.md). Once present, this behaves exactly as
         the brief specifies: PreserveNewest copy to the output directory. -->
    <!-- <Link> flattens the copy to the output directory root (next to the .exe).
         Without it the file lands in bin\...\runtimes\win-x64\native\, which .NET's
         native library probing does NOT search for a plain [DllImport("phonon")] —
         only a real NuGet native package produces a deps.json runtimeTargets entry
         for that layout, a <None> item does not. -->
    <None Include="runtimes\win-x64\native\phonon.dll" Condition="Exists('runtimes\win-x64\native\phonon.dll')">
      <Link>phonon.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
