<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpotifyGameRadio.Core\SpotifyGameRadio.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Condition guards against MSB3030 (missing-file copy error) until phonon.dll
         is actually placed here (Task 8 Step 1, intentionally not done by this
         dispatch — see task-8-report.md). Once present, this behaves exactly as
         the brief specifies: PreserveNewest copy to the output directory. -->
    <None Include="runtimes\win-x64\native\phonon.dll" Condition="Exists('runtimes\win-x64\native\phonon.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
